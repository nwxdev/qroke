{
  "name": "QRokê — Música e karaokê",
  "short_name": "QRokê",
  "description": "A festa é de todo mundo. Música e karaokê com uma fila compartilhada pelo QR Code.",
  "lang": "pt-BR",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101214",
  "theme_color": "#101214",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/site.webmanifest",
      "id": "https://qroke.com.br/"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
