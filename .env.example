# Escolha um PIN de 4 a 8 dígitos antes de iniciar.
QROKE_HOST_PIN=1234
# Controle exclusivo por tempo fixo, em segundos (30 a 3600).
QROKE_ADMIN_LEASE_SECONDS=120
QROKE_PORT=3000
# Endereço alcançável pelos celulares. Evite IP interno de NAT do WSL.
QROKE_PUBLIC_URL=
YOUTUBE_API_KEY=
# Opcionais: acesso às playlists pessoais (OAuth, Aplicativo da Web).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Ajuste a porta; registre exatamente este URI no Google Cloud.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
QROKE_MUSIC_DIR=
# Número máximo de buscas oficiais de emergência por dia (não unidades).
QROKE_QUOTA_DAILY_CAP=90
QROKE_DATABASE=.data/qroke.sqlite

# País do dispositivo PLAYER (ISO 3166-1 alpha-2) para filtrar restrições informadas pelo YouTube.
QROKE_YOUTUBE_REGION=BR
