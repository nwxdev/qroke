# Escolha um PIN de 4 a 8 dígitos antes de iniciar.
QROKE_HOST_PIN=1234
QROKE_PORT=3000
# Endereço alcançável pelos celulares. Evite IP interno de NAT do WSL.
QROKE_PUBLIC_URL=
YOUTUBE_API_KEY=
QROKE_MUSIC_DIR=
# Número máximo de buscas oficiais de emergência por dia (não unidades).
QROKE_QUOTA_DAILY_CAP=90
QROKE_DATABASE=.data/qroke.sqlite
